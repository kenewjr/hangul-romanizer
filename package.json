{
  "name": "hangul-romanizer",
  "version": "0.1.0",
  "description": "Lyrics-first Korean Hangul romanization with RR, MR, phonological rules, and karaoke alignment.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "example": "npm run build && node examples/usage.mjs",
    "pack:check": "npm pack --dry-run --json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "hangul",
    "korean",
    "romanization",
    "lyrics",
    "karaoke",
    "revised-romanization",
    "mccune-reischauer",
    "k-pop"
  ],
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.35.0",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.7"
  }
}
